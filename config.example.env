# Diese Datei nach config.env kopieren und ausfüllen.

# Token von @BotFather (z. B. 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# Öffentlicher Channel: @deinchannelname
# Privater Channel: numerische ID, z. B. -1001234567890
TELEGRAM_CHANNEL=

# Wie oft nach neuen Artikeln gesucht wird (Minuten)
CHECK_INTERVAL_MINUTES=15

# Wie viele aktuelle Artikel beim allerersten Start gepostet werden (0 = keine)
FIRST_RUN_POSTS=3

# Optional: weitere RSS-Feeds, durch Komma getrennt
EXTRA_FEEDS=
